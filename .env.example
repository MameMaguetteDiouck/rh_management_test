# PostgreSQL — utilisé par docker-compose.yml
POSTGRES_USER=name_user
POSTGRES_PASSWORD=bd_password
POSTGRES_DB=nameBD
POSTGRES_PORT=5432

# Adminer
ADMINER_PORT=8080

# Backend (conteneur "backend" de docker-compose.yml)
BACKEND_PORT=3000
JWT_SECRET=change_me_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change_me_too_in_production
JWT_REFRESH_EXPIRATION=7d
CORS_ORIGIN=http://localhost:4200

# Frontend (conteneur "frontend" de docker-compose.yml)
FRONTEND_PORT=4200