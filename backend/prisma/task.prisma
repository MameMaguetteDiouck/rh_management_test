enum TaskStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Task {
  id               String     @id @default(uuid())
  title            String
  description      String
  status           TaskStatus @default(DRAFT)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  rejectionReason  String?

  creatorId String
  creator   User   @relation("CreatedTasks", fields: [creatorId], references: [id])

  validatorId String?
  validator   User?  @relation("ValidatedTasks", fields: [validatorId], references: [id])

  // set uniquement quand un manager crée pour un collaborateur (creatorId part chez le collaborateur,
  
  // du coup sans ce champ le manager ne retrouve plus les tâches qu'il a lui-même distribuées)
  assignedById String?
  assignedBy   User?   @relation("AssignedTasks", fields: [assignedById], references: [id])

  // colonnes filtrées par TasksService.findAll() (statut du pipeline, tâches validées/assignées par un manager)
  @@index([status])
  @@index([creatorId])
  @@index([validatorId])
  @@index([assignedById])
}