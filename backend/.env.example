# Connexion Prisma vers PostgreSQL
DATABASE_URL="postgresql://rh_user:rh_password@localhost:5432/rh_db"

# JWT
JWT_SECRET="change_me_in_production"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="change_me_too_in_production"
JWT_REFRESH_EXPIRATION="7d"

# Port du serveur NestJS
PORT=3000

# Origine autorisée pour les cookies cross-site (frontend Angular)
CORS_ORIGIN="http://localhost:4200"